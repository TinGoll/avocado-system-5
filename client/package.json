    "@emotion/css": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "antd": "^6.6.0",
    "axios": "^1.11.0",
    "dayjs": "^1.11.13",
    "es-toolkit": "^1.39.10",
    "google-libphonenumber": "^3.2.42",
    "html2canvas": "^1.4.1",
    "immer": "^10.2.0",
    "jiti": "^2.5.1",
    "jspdf": "^3.0.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.8.2",
    "react-virtuoso": "^4.14.0",
    "swr": "^2.3.6",
    "uuid": "^11.1.0",
    "zustand": "^5.0.8"

{
  "name": "avocado-desktop",
  "productName": "Avocado",
  "version": "0.1.0",
  "description": "Desktop shell for Avocado",
  "author": "Avocado",
  "main": "dist/main.js",
  "private": true,
  "scripts": {
    "build:client": "npm --prefix ../client run build -- --mode electron",
    "build:server": "npm --prefix ../server run build",
    "build:main": "tsc -p tsconfig.json",
    "stage": "node scripts/stage-app.mjs",
    "build": "npm run build:client && npm run build:server && npm run build:main && npm run stage",
    "start": "npm run package && node scripts/start-packaged-app.mjs",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/typeorm": "^11.0.0",
    "better-sqlite3": "12.11.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.4.1",
    "electron-squirrel-startup": "^1.0.1",
    "es-toolkit": "^1.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@types/node": "^24.3.0",
    "electron": "^42.11.1",
    "typescript": "~5.8.3"
  }
}
